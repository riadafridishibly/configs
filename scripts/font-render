#!/usr/bin/env python3
"""Render a large specimen sheet for a font, using only that font.

    ./font-render path/to/Font.ttf
    ./font-render Font.ttf -s 220 --dark
    ./font-render Font.ttf -t "Ssa0Og" -s 400
    ./font-render Font.ttf --html

Pass more than one font to overlay them, each in its own colour, drawn in
argument order on a shared baseline:

    ./font-render Old.ttf New.ttf                 # multiply: shared ink goes dark
    ./font-render Old.ttf New.ttf --blend diff    # only what changed
    ./font-render Iosevka.ttf JetBrains.ttf --align x

Glyphs are rasterised through FreeType/HarfBuzz with the given faces only, so
anything a font lacks shows up as .notdef rather than a substituted glyph.
"""

import argparse
import base64
import json
import math
import platform
import subprocess
import sys
from pathlib import Path

try:
    from PIL import Image, ImageChops, ImageDraw, ImageFont, features
except ImportError:
    sys.exit("font-render needs Pillow:  pip3 install pillow")

UPPER = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
LOWER = "abcdefghijklmnopqrstuvwxyz"
DIGITS = "0123456789"
PUNCT = "!\"#$%&'()*+,-./:;<=>?@[\\]^_`{|}~"

DEFAULT_SETS = [("Uppercase", UPPER), ("Lowercase", LOWER),
                ("Digits", DIGITS), ("Punctuation & symbols", PUNCT)]

WATERFALL_TEXT = "Hamburgefonstiv 0O1lI {}[]() ->=="
WATERFALL_SIZES = [72, 48, 36, 28, 22, 18, 15, 13, 11, 9]

SAMPLES = [
    "The quick brown fox jumps over the lazy dog",
    "Pack my box with five dozen liquor jugs 0123456789",
    "0O oQ 1lI| 2Z 5S 8B rn/m cl/d vv/w ;: ,. '\" -_ ~^",
    "-> => != !== <= >= === ++ -- << >> ... :: |> <$> /* */",
    "const sum = (a, b) => a + b;  // x != y && z >= 0",
    "if (i <= n) { arr[i] = *ptr++; }  /* #!/usr/bin/env */",
]

THEMES = {
    "light": dict(bg=(255, 255, 255), ink=(20, 20, 20), label=(150, 150, 150),
                  rule=(228, 228, 228), guide=(226, 232, 240),
                  baseline=(190, 200, 214), side=(244, 214, 214),
                  cell=(250, 250, 250), shared=(214, 214, 218)),
    "dark": dict(bg=(22, 22, 26), ink=(238, 238, 240), label=(120, 120, 128),
                 rule=(52, 52, 58), guide=(48, 56, 68),
                 baseline=(80, 92, 110), side=(96, 62, 62),
                 cell=(30, 30, 35), shared=(70, 70, 78)),
}

PALETTE = {
    "light": [(20, 20, 24), (214, 40, 72), (30, 110, 220), (0, 150, 90),
              (196, 118, 0), (150, 60, 200)],
    "dark": [(238, 238, 240), (255, 96, 116), (96, 172, 255), (58, 214, 142),
             (255, 190, 70), (198, 140, 255)],
}

UI_FONT_CANDIDATES = [
    "/System/Library/Fonts/Supplemental/Arial.ttf",
    "/System/Library/Fonts/Helvetica.ttc",
    "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf",
]

REFERENCE_PX = 200  # size at which --align ratios are measured


def ui_font(size):
    for path in UI_FONT_CANDIDATES:
        if Path(path).exists():
            try:
                return ImageFont.truetype(path, size)
            except OSError:
                continue
    return ImageFont.load_default(size)


def apply_variations(face, variations):
    """Set variable-font axes from a list of (tag_or_name, value)."""
    if not variations:
        return
    try:
        axes = face.get_variation_axes()
    except OSError:
        sys.exit("--var given but this font has no variation axes")
    values = [a["default"] for a in axes]
    for name, value in variations:
        for i, axis in enumerate(axes):
            tag = axis.get("name", b"")
            tag = tag.decode() if isinstance(tag, bytes) else str(tag)
            if name.lower() in tag.lower():
                values[i] = value
                break
        else:
            sys.exit(f"no axis matching {name!r}; font has "
                     f"{[a.get('name') for a in axes]}")
    face.set_variation_by_axes(values)


class Layer:
    """One font in the stack, with its own colour and optional size scaling."""

    def __init__(self, path, index, colour, layout, variations):
        self.path, self.index, self.colour = path, index, colour
        self.layout, self.variations = layout, variations
        self.scale = 1.0
        self._faces = {}

    def face(self, size):
        px = max(1, round(size * self.scale))
        if px not in self._faces:
            try:
                f = ImageFont.truetype(str(self.path), px, index=self.index,
                                       layout_engine=self.layout)
            except OSError as exc:
                sys.exit(f"cannot open {self.path.name}: {exc}")
            apply_variations(f, self.variations)
            self._faces[px] = f
        return self._faces[px]

    @property
    def name(self):
        family, style = self.face(REFERENCE_PX).getname()
        return f"{family} {style}"


def align_layers(layers, mode):
    """Scale layers so cap-height or x-height matches the first font's."""
    if mode == "em" or len(layers) < 2:
        return
    probe = "H" if mode == "cap" else "x"

    def height(layer):
        face = layer.face(REFERENCE_PX)
        ascent, _ = face.getmetrics()
        return ascent - face.getbbox(probe)[1]

    base = height(layers[0])
    for layer in layers[1:]:
        own = height(layer)
        if own:
            layer.scale = base / own
            layer._faces.clear()


def stack_metrics(layers, size):
    """Ascent/descent that clear every layer at this nominal size."""
    pairs = [layer.face(size).getmetrics() for layer in layers]
    return max(a for a, _ in pairs), max(d for _, d in pairs)


def advance_of(layers, chars, size):
    probe = ImageDraw.Draw(Image.new("L", (1, 1)))
    return max(probe.textlength(c, font=layer.face(size))
               for layer in layers for c in chars)


class Sheet:
    """Chrome is drawn straight onto the canvas; glyphs go to per-layer masks
    that are composited at the end according to the blend mode."""

    def __init__(self, width, height, theme, pad, layers, blend, alpha):
        self.img = Image.new("RGB", (width, height), theme["bg"])
        self.d = ImageDraw.Draw(self.img)
        self.masks = [Image.new("L", (width, height), 0) for _ in layers]
        self.md = [ImageDraw.Draw(m) for m in self.masks]
        self.theme, self.pad, self.layers = theme, pad, layers
        self.blend, self.alpha = blend, alpha
        self.w, self.y = width, pad

    def glyph(self, xy, text, size, anchor, feats):
        for draw, layer in zip(self.md, self.layers):
            draw.text(xy, text, font=layer.face(size), fill=255,
                      anchor=anchor, features=feats)

    def heading(self, text, size=22):
        self.y += size // 2
        self.d.text((self.pad, self.y), text, font=ui_font(size),
                    fill=self.theme["label"])
        self.y += size + 8
        self.d.line((self.pad, self.y, self.w - self.pad, self.y),
                    fill=self.theme["rule"])
        self.y += size // 2

    def _paint(self, mask, colour):
        self.img.paste(Image.new("RGB", self.img.size, colour), (0, 0), mask)

    def _composite(self):
        if self.blend == "diff":
            a, b = self.masks
            self._paint(ImageChops.darker(a, b), self.theme["shared"])
            self._paint(ImageChops.subtract(a, b), self.layers[0].colour)
            self._paint(ImageChops.subtract(b, a), self.layers[1].colour)
            return
        if self.blend == "over":
            scale = round(self.alpha * 255)
            for mask, layer in zip(self.masks, self.layers):
                self._paint(mask.point(lambda v: v * scale // 255), layer.colour)
            return
        # multiply on light backgrounds, screen on dark: shared ink separates
        # from single-font ink either way.
        dark = sum(self.theme["bg"]) < 380
        merge, ground = ((ImageChops.screen, (0, 0, 0)) if dark
                         else (ImageChops.multiply, (255, 255, 255)))
        for mask, layer in zip(self.masks, self.layers):
            tinted = Image.composite(
                Image.new("RGB", self.img.size, layer.colour),
                Image.new("RGB", self.img.size, ground), mask)
            self.img = merge(self.img, tinted)

    def finish(self):
        self._composite()
        return self.img.crop((0, 0, self.w, min(self.y + self.pad, self.img.height)))


def dashed(draw, y, x0, x1, colour, dash=6, gap=6):
    x = x0
    while x < x1:
        draw.line((x, y, min(x + dash, x1), y), fill=colour)
        x += dash + gap


def draw_grid(sheet, chars, size, cols, guides, feats):
    th, d, base = sheet.theme, sheet.d, sheet.layers[0]
    ascent, descent = stack_metrics(sheet.layers, size)
    cell_w = int(advance_of(sheet.layers, chars, size) * 1.7) + 24
    cell_h = int((ascent + descent) * 1.35) + 34
    baseline_off = int(ascent * 1.15)

    ref = base.face(size)
    ref_ascent = ref.getmetrics()[0]
    x_top, cap_top = ref.getbbox("x")[1], ref.getbbox("H")[1]

    for i, ch in enumerate(chars):
        col, row = i % cols, i // cols
        x0 = sheet.pad + col * cell_w
        y0 = sheet.y + row * cell_h
        cx = x0 + cell_w // 2
        base_y = y0 + baseline_off

        d.rectangle((x0, y0, x0 + cell_w - 2, y0 + cell_h - 2), fill=th["cell"])

        if guides:
            gx0, gx1 = x0 + 4, x0 + cell_w - 6
            dashed(d, base_y - (ref_ascent - x_top), gx0, gx1, th["guide"])
            dashed(d, base_y - (ref_ascent - cap_top), gx0, gx1, th["guide"])
            dashed(d, base_y - ascent, gx0, gx1, th["guide"])
            dashed(d, base_y + descent, gx0, gx1, th["guide"])
            d.line((gx0, base_y, gx1, base_y), fill=th["baseline"])
            adv = ImageDraw.Draw(Image.new("L", (1, 1))).textlength(ch, font=ref)
            for sx in (cx - adv / 2, cx + adv / 2):
                d.line((sx, y0 + 4, sx, y0 + cell_h - 24), fill=th["side"])

        sheet.glyph((cx, base_y), ch, size, "ms", feats)
        d.text((cx, y0 + cell_h - 18), f"U+{ord(ch):04X}", font=ui_font(11),
               fill=th["label"], anchor="ma")

    sheet.y += math.ceil(len(chars) / cols) * cell_h + 10


def draw_lines(sheet, entries, feats, gutter):
    """entries: list of (size, text), each on its own baseline."""
    for size, text in entries:
        ascent, descent = stack_metrics(sheet.layers, size)
        sheet.glyph((sheet.pad + gutter, sheet.y + ascent), text, size, "ls", feats)
        if gutter:
            sheet.d.text((sheet.pad, sheet.y + ascent), str(size), font=ui_font(11),
                         fill=sheet.theme["label"], anchor="ls")
        sheet.y += ascent + descent + max(6, size // 5)


def measure_lines(layers, entries, feats):
    probe = ImageDraw.Draw(Image.new("L", (1, 1)))
    width = height = 0
    for size, text in entries:
        ascent, descent = stack_metrics(layers, size)
        width = max(width, *(int(probe.textlength(text, font=layer.face(size),
                                                  features=feats))
                             for layer in layers))
        height += ascent + descent + max(6, size // 5)
    return width, height


def draw_legend(sheet, size=15):
    if len(sheet.layers) < 2:
        return
    x = sheet.pad
    for layer in sheet.layers:
        sheet.d.rectangle((x, sheet.y + 3, x + 11, sheet.y + 14), fill=layer.colour)
        label = layer.name
        if abs(layer.scale - 1) > 0.005:
            label += f"  ×{layer.scale:.3f}"
        sheet.d.text((x + 18, sheet.y), label, font=ui_font(size),
                     fill=sheet.theme["label"])
        x += 18 + int(sheet.d.textlength(label, font=ui_font(size))) + 26
    sheet.y += size + 14


def render_png(args, layers, feats):
    theme = THEMES["dark" if args.dark else "light"]
    pad = 40

    sets = [("Custom", args.text)] if args.text else DEFAULT_SETS
    sets = [(name, chars) for name, chars in sets if chars]
    widest = max(len(c) for _, c in sets)
    cols = min(args.cols or 13, widest)

    want = lambda block: args.only in (None, block)  # noqa: E731
    grids = sets if want("grid") else []
    waterfall = [(s, WATERFALL_TEXT) for s in WATERFALL_SIZES] if want("waterfall") else []
    samples = [(args.sample_size, t) for t in SAMPLES] if want("samples") else []

    ascent, descent = stack_metrics(layers, args.size)
    cell_h = int((ascent + descent) * 1.35) + 34
    cell_w = int(advance_of(layers, "".join(c for _, c in sets),
                            args.size) * 1.7) + 24
    wf_w, wf_h = measure_lines(layers, waterfall, feats)
    sp_w, sp_h = measure_lines(layers, samples, feats)

    width = max(cols * cell_w, wf_w + 60, sp_w, 900) + pad * 2
    grid_h = sum(math.ceil(len(c) / cols) * cell_h + 60 for _, c in grids)
    height = pad * 2 + 160 + grid_h + wf_h + sp_h + 300

    sheet = Sheet(width, height, theme, pad, layers, args.blend, args.alpha)

    sheet.d.text((pad, sheet.y), layers[0].name, font=ui_font(30), fill=theme["ink"])
    sheet.y += 38
    meta = f"{layers[0].path.name}   ·   grid {args.size}px"
    if len(layers) > 1:
        meta += (f"   ·   {len(layers)} layers, blend {args.blend}"
                 f"   ·   align {args.align}")
    sheet.d.text((pad, sheet.y), meta, font=ui_font(13), fill=theme["label"])
    sheet.y += 24
    draw_legend(sheet)

    for name, chars in grids:
        sheet.heading(f"{name}  ({len(chars)})")
        draw_grid(sheet, chars, args.size, cols, not args.no_guides, feats)
    if waterfall:
        sheet.heading("Waterfall")
        draw_lines(sheet, waterfall, feats, gutter=34)
    if samples:
        sheet.heading(f"Samples  ({args.sample_size}px)")
        draw_lines(sheet, samples, feats, gutter=0)

    out = Path(args.out) if args.out else layers[0].path.with_suffix(".specimen.png")
    sheet.finish().save(out)
    return out


HTML = """<meta charset="utf-8"><title>{name}</title>
<style>
{faces}
:root {{ color-scheme: {scheme}; --bg: {bg}; --fg: {fg}; }}
body {{ margin: 0; background: var(--bg); color: var(--fg);
       font: 13px/1.5 system-ui, sans-serif; }}
header {{ position: sticky; top: 0; z-index: 1; padding: 12px 20px; background: var(--bg);
         border-bottom: 1px solid color-mix(in srgb, var(--fg) 15%, transparent);
         display: flex; gap: 18px; align-items: center; flex-wrap: wrap; }}
h1 {{ font-size: 14px; margin: 0; font-weight: 600; }}
h2 {{ font-size: 11px; text-transform: uppercase; letter-spacing: .08em;
     opacity: .5; margin: 26px 0 8px; }}
label {{ display: flex; gap: 6px; align-items: center; }}
#legend {{ display: flex; gap: 14px; margin-left: auto; flex-wrap: wrap; }}
#legend label {{ gap: 5px; }}
#legend i {{ width: 11px; height: 11px; border-radius: 2px; display: inline-block; }}
section {{ padding: 8px 20px 40px; }}
.spec {{ font-variant-ligatures: contextual common-ligatures; white-space: pre; }}
.stack {{ position: relative; display: inline-block; vertical-align: top; }}
.stack .spec {{ display: block; }}
.stack .spec ~ .spec {{ position: absolute; top: 0; left: 0; }}
section {{ overflow-x: auto; }}
{layercss}
#grid {{ display: flex; flex-wrap: wrap; gap: 4px; }}
#grid .cell {{ background: color-mix(in srgb, var(--fg) 5%, transparent);
              border-radius: 4px; padding: .1em .25em; }}
#live {{ font-family: {family0}; color: {colour0}; outline: none; padding: 10px;
        border: 1px dashed color-mix(in srgb, var(--fg) 25%, transparent);
        border-radius: 6px; }}
#mirror {{ padding: 10px; }}
</style>
<header>
  <h1>{name}</h1>
  <label>size <input id="sz" type="range" min="8" max="500" value="{size}">
    <output id="szv">{size}</output>px</label>
  <label><input id="lig" type="checkbox" checked> ligatures</label>
  <div id="legend"></div>
</header>
<section>
  <h2>Type here</h2>
  <div id="live" contenteditable spellcheck="false">{sample}</div>
  <div id="mirror"></div>
  <h2>Characters</h2><div id="grid"></div>
  <h2>Samples</h2><div id="samples"></div>
  <h2>Waterfall</h2><div id="wf"></div>
</section>
<script>
const FONTS = {fonts};
const CHARS = {chars};
const SAMPLES = {samples};
const WF = {wfsizes};
const esc = t => t.replace(/[<&]/g, m => m === '<' ? '&lt;' : '&amp;');
const stack = t => `<span class="stack">` +
  FONTS.map((f, i) => `<span class="spec l${{i}}">${{esc(t)}}</span>`).join('') + `</span>`;

document.getElementById('legend').innerHTML = FONTS.map((f, i) =>
  `<label><input type="checkbox" data-i="${{i}}" checked>` +
  `<i style="background:${{f.colour}}"></i>${{esc(f.name)}}</label>`).join('');
document.getElementById('grid').innerHTML =
  [...CHARS].map(c => `<span class="cell">${{stack(c)}}</span>`).join('');
document.getElementById('samples').innerHTML =
  SAMPLES.map(s => `<div>${{stack(s)}}</div>`).join('');
document.getElementById('wf').innerHTML = WF.map(s =>
  `<div style="font-size:${{s}}px">${{stack(s + '\\u2002\\u2002' + {wftext})}}</div>`).join('');

const live = document.getElementById('live'), mirror = document.getElementById('mirror');
const sz = document.getElementById('sz'), szv = document.getElementById('szv');
const sync = () => {{
  mirror.innerHTML = FONTS.length > 1 ? stack(live.innerText) : '';
  mirror.style.fontSize = live.style.fontSize;
}};
const apply = () => {{
  szv.value = sz.value;
  for (const el of [document.getElementById('grid'), live, document.getElementById('samples')])
    el.style.fontSize = sz.value + 'px';
  sync();
}};
sz.oninput = apply; live.oninput = sync; apply();
document.getElementById('lig').onchange = e => {{
  const v = e.target.checked ? 'contextual common-ligatures' : 'none';
  document.querySelectorAll('.spec, #live').forEach(el => el.style.fontVariantLigatures = v);
}};
document.getElementById('legend').onchange = e => {{
  const i = e.target.dataset.i;
  document.querySelectorAll('.l' + i).forEach(el =>
    el.style.visibility = e.target.checked ? '' : 'hidden');
}};
</script>
"""


def render_html(args, layers):
    dark = args.dark
    theme = THEMES["dark" if dark else "light"]
    blend = "screen" if dark else "multiply"
    hexes = ["#%02x%02x%02x" % layer.colour for layer in layers]

    faces = "\n".join(
        f'@font-face {{ font-family: "F{i}"; src: url(data:font/ttf;base64,'
        f'{base64.b64encode(layer.path.read_bytes()).decode()}); }}'
        for i, layer in enumerate(layers))
    layercss = "\n".join(
        f'.l{i} {{ font-family: "F{i}"; color: {hexes[i]};'
        + (f" mix-blend-mode: {blend};" if i and args.blend != "over" else "")
        + (f" opacity: {args.alpha};" if args.blend == "over" else "")
        + " }" for i in range(len(layers)))

    chars = args.text or (UPPER + LOWER + DIGITS + PUNCT)
    out = Path(args.out) if args.out else layers[0].path.with_suffix(".specimen.html")
    out.write_text(HTML.format(
        name=" + ".join(layer.path.name for layer in layers),
        faces=faces, layercss=layercss, size=args.size,
        scheme="dark" if dark else "light",
        bg="#%02x%02x%02x" % theme["bg"], fg="#%02x%02x%02x" % theme["ink"],
        family0='"F0"', colour0=hexes[0],
        chars=json.dumps(chars), samples=json.dumps(SAMPLES),
        wfsizes=json.dumps(WATERFALL_SIZES), wftext=json.dumps(WATERFALL_TEXT),
        sample=SAMPLES[3],
        fonts=json.dumps([{"name": layer.name, "colour": hexes[i]}
                          for i, layer in enumerate(layers)])))
    return out


def open_file(p):
    opener = {"Darwin": "open", "Windows": "start"}.get(platform.system(), "xdg-open")
    try:
        subprocess.run([opener, str(p)], check=False)
    except FileNotFoundError:
        pass


def parse_var(spec):
    out = []
    for part in spec.split(","):
        if "=" not in part:
            sys.exit(f"--var expects tag=value, got {part!r}")
        tag, value = part.split("=", 1)
        out.append((tag.strip(), float(value)))
    return out


def parse_colour(text):
    h = text.strip().lstrip("#")
    if len(h) != 6:
        sys.exit(f"--colours expects #rrggbb values, got {text!r}")
    return tuple(int(h[i:i + 2], 16) for i in (0, 2, 4))


def main():
    p = argparse.ArgumentParser(
        prog="font-render", description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("font", type=Path, nargs="+",
                   help="one font, or several to overlay in argument order")
    p.add_argument("-s", "--size", type=int, default=160,
                   help="glyph-grid size in px (default 160)")
    p.add_argument("-t", "--text", help="render these characters instead of A-Z/a-z/0-9/punct")
    p.add_argument("-c", "--cols", type=int, help="grid columns (default: fit 13)")
    p.add_argument("-o", "--out", help="output path")
    p.add_argument("--sample-size", type=int, default=26, help="sample-line size (default 26)")
    p.add_argument("--dark", action="store_true")
    p.add_argument("--no-guides", action="store_true",
                   help="hide baseline / x-height / advance-width guides")
    p.add_argument("--only", choices=["grid", "waterfall", "samples"])
    p.add_argument("--index", type=int, default=0, help="face index for .ttc/.otc")
    p.add_argument("--var", help="variable-font axes, e.g. wght=700,wdth=90")
    p.add_argument("--features", help="OpenType features; use = to pass a leading "
                                      "minus, e.g. --features=-dlig or --features ss01")
    p.add_argument("--no-liga", action="store_true", help="disable liga/clig/calt/dlig")
    p.add_argument("--blend", choices=["multiply", "over", "diff"], default="multiply",
                   help="how overlaid fonts combine: multiply/screen (default), "
                        "alpha (over), or diff — differences only, exactly 2 fonts")
    p.add_argument("--alpha", type=float, default=0.6, help="layer opacity for --blend over")
    p.add_argument("--align", choices=["em", "cap", "x"], default="em",
                   help="scale overlaid fonts to match the first font's cap- or "
                        "x-height instead of its em (default em)")
    p.add_argument("--colours", "--colors", dest="colours",
                   help="override layer colours, e.g. '#111111,#e11d48'")
    p.add_argument("--html", action="store_true", help="emit an interactive HTML page instead")
    p.add_argument("--no-open", action="store_true")
    args = p.parse_args()

    paths = [f.expanduser() for f in args.font]
    for path in paths:
        if not path.is_file():
            sys.exit(f"no such font: {path}")
    if args.blend == "diff" and len(paths) != 2:
        sys.exit(f"--blend diff needs exactly 2 fonts, got {len(paths)}")

    palette = PALETTE["dark" if args.dark else "light"]
    if args.colours:
        colours = [parse_colour(c) for c in args.colours.split(",")]
        if len(colours) < len(paths):
            sys.exit(f"--colours needs {len(paths)} values, got {len(colours)}")
    else:
        colours = [palette[i % len(palette)] for i in range(len(paths))]

    if not features.check("raqm"):
        print("note: Pillow lacks libraqm — ligatures/shaping disabled", file=sys.stderr)
    layout = ImageFont.Layout.RAQM if features.check("raqm") else ImageFont.Layout.BASIC
    variations = parse_var(args.var) if args.var else None

    layers = [Layer(path, args.index, colour, layout, variations)
              for path, colour in zip(paths, colours)]
    align_layers(layers, args.align)

    if args.html:
        out = render_html(args, layers)
    else:
        feats = [f.strip() for f in args.features.split(",")] if args.features else []
        if args.no_liga:
            feats += ["-liga", "-clig", "-calt", "-dlig"]
        out = render_png(args, layers, feats or None)

    print(out)
    if not args.no_open:
        open_file(out)


if __name__ == "__main__":
    main()
